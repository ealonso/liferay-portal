{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./src/main/js",
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"jsx": "react",
		"lib": [
			"ES2019",
			"DOM"
		],
		"module": "esnext",
		"moduleResolution": "node",
		"skipLibCheck": true,
		"sourceMap": true,
		"target": "ES5"
	},
	"include": [
		"./src/main/js/**/*"
	]
}