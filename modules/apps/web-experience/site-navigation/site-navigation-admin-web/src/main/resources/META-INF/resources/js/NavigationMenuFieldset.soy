{namespace NavigationMenuFieldset}

/**
 * This renders the main element of NavigationMenuFieldset.
 */
{template .render}
	{@param fields: list<?>}
	{@param name: string}
	{@param? namespace: string}

	<div class="card navigation-menu-fieldset">
		<fieldset class="panel-body">
			<div class="field-name">
				<label class="control-label" for="{$namespace}fieldsetName">
					{msg desc=""}name{/msg}
				</label>

				{let $nameAttributes kind="attributes"}
					class="form-control"
					id="{$namespace}fieldsetName"
					name="{$namespace}fieldsetName"
					type="text"
					value="{$name}"
				{/let}

				<input {$nameAttributes} />
			</div>

			{foreach $field in $fields}
				{call .field}
					{param description: $field.description /}
					{param label: $field.label /}
					{param name: $field.name /}
					{param namespace: not $namespace ? '' : $namespace /}
					{param value: $field.value /}
				{/call}
			{/foreach}

			<div class="button-holder">

				{let $buttonAttributes kind="attributes"}
					class="btn btn-lg btn-primary btn-default"
					data-onclick="_handleAddItemClick"
					type="button"
				{/let}

				<button {$buttonAttributes}>
					<span class="lft-btn-laber">{msg desc=""}add-to-menu{/msg}</span>
				</button>
			</div>
		</fieldset>
	</div>
{/template}

/**
 * This renders the fieldset field
 */
{template .field}
	{@param label: string}
	{@param name: string}
	{@param namespace: string}
	{@param value: string}
	{@param? description: string}

	<div class="fieldset-field">
		<label class="control-label" for="{$namespace}{$name}">
			{$label}
		</label>

		{let $inputAttributes kind="attributes"}
			class="form-control"
			data-fieldname="{$name}"
			id="{$namespace}{$name}"
			name="{$namespace}{$name}"
			type="text"
			value="{$value}"
		{/let}

		<input {$inputAttributes} />

		{if $description}
			<label class="text-muted control-label" for="{$namespace}{$name}">
				{$description}
			</label>
		{/if}
	</div>
{/template}