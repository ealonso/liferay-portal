<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping auto-import="false" default-lazy="false">
	<import class="com.liferay.layout.service.model.LayoutFragment" />
	<class name="com.liferay.layout.service.model.impl.LayoutFragmentImpl" table="LayoutFragment">
		<id name="layoutFragmentId" type="long">
			<generator class="assigned" />
		</id>
		<property name="groupId" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property name="companyId" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property name="userId" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property name="userName" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="createDate" type="org.hibernate.type.TimestampType" />
		<property name="modifiedDate" type="org.hibernate.type.TimestampType" />
		<property name="plid" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property name="fragmentEntryId" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property name="css" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="html" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="js" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="position" type="com.liferay.portal.dao.orm.hibernate.IntegerType" />
		<property name="typeSettings" type="com.liferay.portal.dao.orm.hibernate.StringType" />
	</class>
</hibernate-mapping>