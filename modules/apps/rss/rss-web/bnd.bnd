Bundle-Name: Liferay RSS Web
Bundle-SymbolicName: com.liferay.rss.web
Bundle-Version: 1.0.0
Import-Package:\
	${bnd.jsp.support.imports},\
	com.liferay.portlet.portletdisplaytemplate.util,\
	!com.sun.*,\
	!org.apache.*,\
	!org.slf4j.*,\
	!org.zeroturnaround.*,\
	*
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources,\
	WEB-INF=src/WEB-INF,\
	@lib/javax.servlet.jsp.jstl.jar!/META-INF/*.tld,\
	@../../../../util-java/util-java.jar,\
	@../../../../util-taglib/util-taglib.jar,\
	@../../../../lib/portal/freemarker.jar