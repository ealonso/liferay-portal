Bundle-Name: Liferay Site My Sites Web
Bundle-SymbolicName: com.liferay.site.my.sites.web
Bundle-Version: 1.0.0
Export-Package: com.liferay.site.my.sites.web.constants
Include-Resource:\
	classes,\
	META-INF/resources=src/main/resources/META-INF/resources
Require-Capability:\
    osgi.extender;osgi.extender="jsp.taglib";uri="http://liferay.com/tld/frontend";version:Version="1.0.0"
Require-SchemaVersion: 1.0.0